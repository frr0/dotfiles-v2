" ============================================================================
" ~/.ideavimrc - Configurazione IdeaVim + Which-Key + NERDTree
" Identica al 100% alla configurazione VS Code (LazyVim + WhichKey + .vimrc)
" ============================================================================

" ----------------------------------------------------------------------------
" 1. OPZIONI BASE VIM (da ~/.vimrc & VS Code settings.json)
" ----------------------------------------------------------------------------
set number
set relativenumber
set showmode
set showcmd
set visualbell
set noerrorbells
set ignorecase
set smartcase
set incsearch
set hlsearch
set scrolloff=4
set clipboard+=unnamed

" Leader secondario (come "vim.leader": "<|>" in VS Code settings.json)
let mapleader = "|"

" ----------------------------------------------------------------------------
" 2. PLUGIN IDEAVIM & INTEGRAZIONE IDE
" ----------------------------------------------------------------------------
set which-key
set notimeout
set nerdtree
set ToolWindowNavEverywhere
set ideaoutsideeditor
set ideajoin
set ideamarks

" Tasti passati al popup Autocomplete/Lookup quando e' visibile:
" Permette a Ctrl+j / Ctrl+k e Tab / Shift+Tab di scorrere i suggerimenti!
set lookupkeys=<Tab>,<S-Tab>,<Down>,<Up>,<Enter>,<Left>,<Right>,<C-Down>,<C-Up>,<PageUp>,<PageDown>,<C-J>,<C-K>,<C-Q>

" Configurazione IDEA Which-Key (popup istantaneo a 0ms come in VS Code)
let g:WhichKey_DefaultDelay = 0
let g:WhichKey_SortOrder = "by_key_prefix_first"
let g:WhichKey_ShowVimActions = "true"
let g:WhichKey_ShowTypedSequence = "true"
let g:WhichKey_ProcessUnknownMappings = "false"
let g:WhichKey_FontSize = 15
let g:WhichKey_PrefixColor = "#89b4fa"
let g:WhichKey_KeyColor = "#f9e2af"
let g:WhichKey_CommandColor = "#cdd6f4"
let g:WhichKey_Divider = " ➜ "

" ----------------------------------------------------------------------------
" 3. GESTIONE CONFLITTI SCORCIATOIE (sethandler)
" ----------------------------------------------------------------------------
sethandler <C-h> a:vim
sethandler <C-j> a:vim
sethandler <C-k> a:vim
sethandler <C-l> a:vim
sethandler <C-w> a:vim
sethandler <C-i> a:vim
sethandler <C-m> a:vim
sethandler <C-r> a:vim
sethandler <C-u> a:vim
sethandler <C-d> a:vim
sethandler <C-f> a:vim
sethandler <C-b> a:vim
sethandler <C-v> a:vim
sethandler <C-s> a:ide
sethandler <C-/> a:ide

sethandler <A-Space> a:vim
sethandler <A-,> a:vim
sethandler <A-/> a:vim
sethandler <A-S-;> a:vim
sethandler <A-.> a:vim
sethandler <A-`> a:vim
sethandler <A-a> a:vim
sethandler <A-S-a> a:vim
sethandler <A-b> a:vim
sethandler <A-S-b> a:vim
sethandler <A-c> a:vim
sethandler <A-S-c> a:vim
sethandler <A-d> a:vim
sethandler <A-S-d> a:vim
sethandler <A-e> a:vim
sethandler <A-S-e> a:vim
sethandler <A-f> a:vim
sethandler <A-g> a:vim
sethandler <A-S-g> a:vim
sethandler <A-h> a:vim
sethandler <A-S-h> a:vim
sethandler <A-i> a:vim
sethandler <A-j> a:vim
sethandler <A-S-j> a:vim
sethandler <A-k> a:vim
sethandler <A-l> a:vim
sethandler <A-S-l> a:vim
sethandler <A-m> a:vim
sethandler <A-S-m> a:vim
sethandler <A-n> a:vim
sethandler <A-o> a:vim
sethandler <A-S-o> a:vim
sethandler <A-p> a:vim
sethandler <A-S-p> a:vim
sethandler <A-q> a:vim
sethandler <A-S-q> a:vim
sethandler <A-r> a:vim
sethandler <A-S-r> a:vim
sethandler <A-s> a:vim
sethandler <A-S-s> a:vim
sethandler <A-t> a:vim
sethandler <A-u> a:vim
sethandler <A-v> a:vim
sethandler <A-w> a:vim
sethandler <A-x> a:vim
sethandler <A-y> a:vim
sethandler <A-z> a:vim
sethandler <A-[> a:vim
sethandler <A-]> a:vim
sethandler <A--> a:vim
sethandler <A-\> a:vim
sethandler <A-=> a:vim

" ----------------------------------------------------------------------------
" 4. FILE EXPLORER / PROJECT VIEW (Stile Neo-tree tramite NERDTree)
" ----------------------------------------------------------------------------
let g:NERDTreeMapActivateNode = 'l'
let g:NERDTreeMapPreview = 'o'
let g:NERDTreeMapOpenSplit = 's'
let g:NERDTreeMapOpenVSplit = 'v'
let g:NERDTreeMapCloseDir = 'h'
let g:NERDTreeMapCloseChildren = 'C'
let g:NERDTreeMapNewFile = 'a'
let g:NERDTreeMapNewDir = 'A'
let g:NERDTreeMapRename = 'r'
let g:NERDTreeMapDelete = 'd'
let g:NERDTreeMapCopy = 'y'
let g:NERDTreeMapPaste = 'p'
let g:NERDTreeMapRefresh = 'R'
let g:NERDTreeMapRefreshRoot = 'R'
let g:NERDTreeMapToggleZoom = 'z'
let g:NERDTreeMapJumpParent = 'P'
let g:NERDTreeMapFind = '/'
let g:NERDTreeMapQuit = 'q'

" ----------------------------------------------------------------------------
" 5. KEYBINDINGS PRE-ESISTENTI (da ~/.vimrc & VS Code settings.json)
" ----------------------------------------------------------------------------
" Inizio e fine riga
nnoremap \ 0
vnoremap \ 0
nnoremap 1 0
vnoremap 1 0
nnoremap 0 $
vnoremap 0 $

" Salto tra paragrafi con + e -
nnoremap + {
vnoremap + {
nnoremap - }
vnoremap - }

" Ricerca e sostituzione globale
nmap gc :%s/

" Copia fino a fine riga / intera riga senza newline
nnoremap Y y$
nnoremap yt 0y$

" Riformatta/indenta tutto il file
nnoremap g0 gg=GGG
nmap g0 <Action>(ReformatCode)

" Indenta/de-indenta in Visual Mode mantenendo la selezione
vnoremap < <gv
vnoremap > >gv

" Auto-chiusura parentesi e virgolette in Insert Mode
inoremap " ""<Left>
inoremap ' ''<Left>
inoremap ( ()<Left>
inoremap [ []<Left>
inoremap { {}<Left>

" Split rapidi con Ctrl+w e Ctrl+i e compilazione con Ctrl+m (da ~/.vimrc)
nnoremap <C-w> :vsp<CR>
nnoremap <C-i> :split<CR>
nnoremap <C-m> <Action>(SaveAll)<Action>(CompileDirty)

" Leader '|' (da vim.normalModeKeyBindingsNonRecursive in settings.json)
nnoremap <Bar>w <Action>(SplitVertically)
nnoremap <Bar>f <Action>(SelectInProjectView)
nnoremap <Bar>h _

" ----------------------------------------------------------------------------
" 6. SCORCIATOIE GLOBALI NON-LEADER (Finestre, Buffer, Hover, LSP)
" ----------------------------------------------------------------------------
" Navigazione tra split / finestre con Ctrl + h/j/k/l
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
vnoremap <C-h> <C-w>h
vnoremap <C-l> <C-w>l
vnoremap <C-j> <C-w>j
vnoremap <C-k> <C-w>k

" Navigazione Buffer / Tab con Shift + h / Shift + l
nnoremap H <Action>(PreviousTab)
nnoremap L <Action>(NextTab)
vnoremap H <Action>(PreviousTab)
vnoremap L <Action>(NextTab)

" Hover / Documentazione LSP con Shift + k (K) e gh
nnoremap K <Action>(ShowHoverInfo)
vnoremap K <Action>(ShowHoverInfo)
nnoremap gh <Action>(ShowHoverInfo)

" Scorciatoie LSP standard LazyVim / VSCodeVim
nnoremap gd <Action>(GotoDeclaration)
nnoremap gD <Action>(QuickImplementations)
nnoremap gr <Action>(ShowUsages)
nnoremap gI <Action>(GotoImplementation)
nnoremap gy <Action>(GotoTypeDeclaration)
nnoremap gcc <Action>(CommentByLineComment)
vnoremap gc <Action>(CommentByLineComment)

" ----------------------------------------------------------------------------
" 7. COMANDI DIRETTI TOP-LEVEL (ALT + <TASTO>)
" ----------------------------------------------------------------------------
let g:WhichKeyDesc_root_space     = "<A-Space><Space> Find Files"
let g:WhichKeyDesc_root_space_alt = "<A-Space><A-Space>"
let g:WhichKeyDesc_top_comma      = "<A-,> Switch Buffer"
