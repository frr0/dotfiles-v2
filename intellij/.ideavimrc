let g:WhichKeyDesc_top_explorer_f = "<A-S-e> Explorer (Reveal Active File)"
let g:WhichKeyDesc_top_lazy       = "<A-l> Plugins / Extensions"

map <A-Space><Space>   <Action>(GotoFile)
map <A-Space><A-Space> <Action>(GotoFile)
