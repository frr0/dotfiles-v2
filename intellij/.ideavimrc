map <A-Space>`         <Action>(Switcher)
map <A-Space><A-`>     <Action>(Switcher)
map <A-Space>e         <Action>(ActivateProjectToolWindow)
map <A-Space><A-e>     <Action>(ActivateProjectToolWindow)
map <A-Space>E         <Action>(SelectInProjectView)
map <A-Space><A-S-e>   <Action>(SelectInProjectView)
map <A-Space>l         <Action>(WelcomeScreen.Plugins)
map <A-Space><A-l>     <Action>(WelcomeScreen.Plugins)

let g:WhichKeyDesc_root_comma      = "<A-Space>, Switch Buffer"
let g:WhichKeyDesc_root_slash      = "<A-Space>/ Grep (Root Dir)"
let g:WhichKeyDesc_root_colon      = "<A-Space>: Command Palette"
