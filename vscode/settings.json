{ "workbench.colorTheme": "Dark Modern",
  "telemetry.enableCrashReporter": false,
  "telemetry.enableTelemetry": false,
  "editor.scrollbar.horizontal": "visible",
  "editor.scrollbar.vertical": "visible",
  "workbench.list.automaticKeyboardNavigation": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
  "editor.matchBrackets": "never",
  "workbench.startupEditor": "newUntitledFile",
  "vim.vimrc.path": "~/.vimrc",
  "vim.vimrc.enable": true,
  "breadcrumbs.filePath": "off",
  "C_Cpp.intelliSenseEngine": "Enabled",
  "latex-workshop.view.pdf.viewer": "tab",
  "editor.scrollBeyondLastLine": false,
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
    "terminal.integrated.profiles.windows": {
        "Nushell": {
            "path": "nu" // Use "nu" if it's in your PATH, otherwise provide the full path
        }
    },
    "terminal.integrated.defaultProfile.windows": "Nushell"
  },
  "vim.normalModeKeyBindingsNonRecursive": [

    {
      "before": [
        "<leader>",
        "w"
      ],
      "commands": [
        "workbench.action.splitEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "-workbench.view.explorer"
      ],
      "when": [
        "viewContainer.workbench.view.explorer.enabled"
      ]
    },
    {
      "before": [
        "<leader>",
        "f"
      ],
      "commands": [
        "revealInExplorer"
      ]
    },
    {
      "before": [
        "<leader>",
        "f"
      ],
      "commands": [
        "filesExplorer.findInFolder"
      ],
      "when": [
        "explorerResourceIsFolder && explorerViewletVisible && filesExplorerFocus && !inputFocus"
      ]
    },
    {
      "before": [
        "<leader>",
        "h"
      ],
      "after": [
        "_"
      ]
    },
    {
      "before": [
        "<C-w>",
        "h"
      ],
      "after": [
        "<C-h>"
      ]
    },
    {
      "before": [
        "<C-w>",
        "j"
      ],
      "after": [
        "<C-j>"
      ]
    },
    {
      "before": [
        "<C-w>",
        "k"
      ],
      "after": [
        "<C-k>"
      ]
    },
    {
      "before": [
        "<C-w>",
        "l"
      ],
      "after": [
        "<C-l>"
      ]
    },
    {
      "before": [
        "+"
      ],
      "after": [
        "{"
      ]
    },
    {
      "before": [
        "-"
      ],
      "after": [
        "}"
      ]
    },
    {
      "before": [
        "1"
      ],
      "after": [
        "0"
      ]
    },
    {
      "before": [
        "0"
      ],
      "after": [
        "$"
      ]
    },
    {
      "before": [
        "\\"
      ],
      "after": [
        "0"
      ]
    },
    {
      "before": [
        "1"
      ],
      "after": [
        "1"
      ]
    }
  ],
  "vim.leader": "<|>",
  "C_Cpp.addNodeAddonIncludePaths": true,
  "explorer.confirmDelete": false,
  "tabnine.experimentalAutoImports": false,
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "workbench.tree.renderIndentGuides": "none",
  "workbench.editorAssociations": {
    "*.html": "default",
    "*.pdf": "latex-workshop-pdf-hook"
